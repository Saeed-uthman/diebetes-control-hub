# ===========================================
# DiabetesCare App - Environment Configuration
# ===========================================

# API Base URL - Points to the PHP backend
#
# LOCAL DEVELOPMENT (XAMPP):
#   1. Copy the /api folder to your XAMPP htdocs: C:/xampp/htdocs/diabetes-api/api
#   2. Set the URL below to point to your XAMPP server:
VITE_API_URL=http://localhost/diabetes-api/api
#
# LOCAL DEVELOPMENT (MAMP):
#   VITE_API_URL=http://localhost:8888/diabetes-api/api
#
# PRODUCTION (cPanel / live server):
#   VITE_API_URL=https://your-domain.com/api
#
# IMPORTANT: No trailing slash! The services append endpoints like /auth/login
